# Deployment configuration template (Phase 11).
# Copy to `.env` next to docker-compose.yml and fill values. NEVER commit a
# real .env. The full contract — where each variable is configured, which
# component consumes it, required-ness, defaults, and behavior when missing —
# is docs/EXECUTION_PLANE_DEPLOYMENT.md.

# --- Execution-plane authentication (REQUIRED in production) -----------------
# Shared bearer token: the Convex control plane presents it; this backend
# verifies it. Generate once (e.g. `openssl rand -hex 32`) and set the SAME
# value in BOTH places: this file (backend container) and the Convex
# deployment environment (`bun convex env set EXECUTION_BRIDGE_TOKEN ...`).
# BEHAVIOR WHEN UNSET: every /api/v1/runs* route stays OPEN (local/dev
# posture only — never acceptable on a publicly reachable deployment).
EXECUTION_BRIDGE_TOKEN=

# --- Control-plane -> execution-plane address --------------------------------
# The stable HTTPS URL of this backend as reachable from Convex cloud.
# Configure in the CONVEX deployment env (bun convex env set), not here.
# BEHAVIOR WHEN UNSET: every bridge submission fails honestly with
# "execution backend unreachable" — the run becomes execution_error;
# simulation is never substituted (no silent fallback, by design).
# EXECUTION_BRIDGE_URL=https://your-execution-plane.example.com

# --- Workload safety limits (backend; consumed by workload_limits.py) --------
# Server-side ceilings enforced before a plan is persisted or executed.
MAX_VUS=2000
MAX_DURATION_S=90

# --- Execution timeout (backend; k6 subprocess wall-clock ceiling) -----------
# A process safety net against a hung k6; must stay comfortably ABOVE
# MAX_DURATION_S so legitimate runs are never killed mid-flight.
K6_EXECUTION_TIMEOUT_S=120

# --- SSRF policy (backend; target_url_safety.py) -----------------------------
# allow_private (default) permits loopback/private targets — required for
# the controlled demo API. block_private for a stricter deployment.
# Cloud-metadata addresses are ALWAYS blocked regardless of this setting.
TARGET_SSRF_POLICY=allow_private

# --- Paths / storage (backend) -----------------------------------------------
# ARTIFACTS_DIR (default: <backend>/artifacts) — per-run artifact root;
# the container mounts a volume here. DATABASE_URL (default: sqlite at
# <backend>/app.db). Values are deployment-local; names only are reported
# by GET /api/v1/version.
# ARTIFACTS_DIR=/data/artifacts
# DATABASE_URL=sqlite:////data/app.db

# --- LLM intent interpretation (backend; optional) ---------------------------
# OpenAI-compatible chat API. LLM_API_KEY has NO default on purpose: unset
# means interpretation falls back to the deterministic interpreter and the
# version manifest reports provider "unconfigured". Never commit a key.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- CORS (backend) -----------------------------------------------------------
# Explicit origins only, never "*".
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Immutable build identity (backend; optional) -----------------------------
# Baked at image build time when known; reported verbatim by
# GET /api/v1/version. NEVER inferred — absent stays "UNKNOWN".
# BACKEND_GIT_COMMIT=

# --- Demo API tuning (demo-api container) -------------------------------------
HOST=0.0.0.0
PORT=8080
DB_LATENCY_MS=150
CHECKOUT_DELAY_MS=800
ERROR_INJECTION_FAIL_PERCENT=30
