# LLM intent interpreter (app/services/llm_intent_interpreter.py).
# Never commit a real .env file -- already gitignored (.env, .env.*).
# This repo has no dotenv dependency; these are plain environment
# variables, same convention as K6_BINARY/MAX_VUS/etc in app/core/config.py.
# Set them in your shell, or `Set-Content` a local .env and source it
# yourself -- whatever your shell prefers.

# Required to actually call a real provider. Empty/unset -> every call
# fails fast with a clean 401 from the provider, mapped to
# INTERPRETATION_FAILURE -- the backend never crashes without a key.
LLM_API_KEY=

# Any OpenAI-compatible chat-completions model name.
LLM_MODEL=gpt-4o-mini

# Any OpenAI-compatible base URL (OpenAI itself, Groq, OpenRouter, a local
# server, etc.) -- must serve POST {LLM_BASE_URL}/chat/completions.
LLM_BASE_URL=https://api.openai.com/v1

# Provider request timeout, in seconds.
LLM_TIMEOUT_S=20

# Comma-separated closed set of endpoints the LLM may select from for the
# demo e-commerce target. Defaults to the demo API's real, verified
# OpenAPI surface if unset -- override only if pointing at a different
# target.
LLM_KNOWN_ENDPOINTS=/products,/products/{product_id},/categories,/categories/{category_id},/cart,/checkout
